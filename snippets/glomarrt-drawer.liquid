{% doc %}
  Glomarrt mobile menu content: colored category tiles, then
  "about" and "policies" link lists. Rendered inside header-drawer.

  Tiles come from the header's "Menu: category" blocks. With no blocks,
  the header's main menu links are used instead.
{% enddoc %}
{%- liquid
  assign palette = '#a8eebc,#bfe6fb,#ffef9a,#f9e5c3,#ffc9c9,#ffc7b0,#e4e1dc,#d9fbfb,#e4e683' | split: ','
  assign tile_blocks = section.blocks | where: 'type', 'drawer_category'
  if tile_blocks.size > 0
    assign tile_count = tile_blocks.size
  else
    assign tile_count = section.settings.menu.links.size
  endif
  assign odd_count = tile_count | modulo: 2
-%}

<div class="glomarrt-drawer">
  {%- if tile_count > 0 -%}
    {%- if section.settings.drawer_categories_heading != blank -%}
      <p class="glomarrt-drawer__label">{{ section.settings.drawer_categories_heading }}</p>
    {%- endif -%}
    <ul class="glomarrt-drawer__tiles list-unstyled" role="list">
      {%- if tile_blocks.size > 0 -%}
        {%- for block in tile_blocks -%}
          {%- liquid
            assign cat = block.settings.collection
            assign tile_title = block.settings.title
            if tile_title == blank and cat != blank
              assign tile_title = cat.title
            endif
            if tile_title == blank
              assign tile_title = 'glomarrt.category' | t
            endif
            assign tile_url = block.settings.link
            if tile_url == blank and cat != blank
              assign tile_url = cat.url
            endif
            assign tile_image = block.settings.image
            assign tile_image_is_icon = true
            if tile_image == blank and cat != blank
              assign tile_image = cat.featured_image
              assign tile_image_is_icon = false
            endif
            assign color_index = forloop.index0 | modulo: palette.size
            assign tile_color = block.settings.color
            if tile_color == blank
              assign tile_color = palette[color_index]
            endif
            assign wide = false
            if forloop.first and odd_count == 1
              assign wide = true
            endif
          -%}
          <li class="glomarrt-drawer__tile-item{% if wide %} glomarrt-drawer__tile-item--wide{% endif %}" {{ block.shopify_attributes }}>
            <a
              {% if tile_url != blank %}href="{{ tile_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
              class="glomarrt-drawer__tile focus-inset"
              style="--tile-bg: {{ tile_color }};"
            >
              <span class="glomarrt-drawer__icon{% unless tile_image_is_icon %} glomarrt-drawer__icon--photo{% endunless %}">
                {%- if tile_image != blank -%}
                  {{ tile_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </span>
              <span class="glomarrt-drawer__tile-title">{{ tile_title }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for link in section.settings.menu.links -%}
          {%- liquid
            assign color_index = forloop.index0 | modulo: palette.size
            assign tile_image = blank
            if link.type == 'collection_link'
              assign tile_image = link.object.featured_image
            elsif link.type == 'product_link'
              assign tile_image = link.object.featured_image
            endif
            assign wide = false
            if forloop.first and odd_count == 1
              assign wide = true
            endif
          -%}
          <li class="glomarrt-drawer__tile-item{% if wide %} glomarrt-drawer__tile-item--wide{% endif %}">
            <a href="{{ link.url }}" class="glomarrt-drawer__tile focus-inset" style="--tile-bg: {{ palette[color_index] }};">
              <span class="glomarrt-drawer__icon glomarrt-drawer__icon--photo">
                {%- if tile_image != blank -%}
                  {{ tile_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </span>
              <span class="glomarrt-drawer__tile-title">{{ link.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  {%- endif -%}

  {%- liquid
    assign about_menu = section.settings.drawer_about_menu
    assign policies_menu = section.settings.drawer_policies_menu
  -%}

  {%- if about_menu != blank and about_menu.links.size > 0 -%}
    <div class="glomarrt-drawer__group">
      {%- if section.settings.drawer_about_heading != blank -%}
        <p class="glomarrt-drawer__group-title">{{ section.settings.drawer_about_heading }}</p>
      {%- endif -%}
      <ul class="glomarrt-drawer__links list-unstyled" role="list">
        {%- for link in about_menu.links -%}
          <li><a href="{{ link.url }}" class="glomarrt-drawer__link focus-inset"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if policies_menu != blank and policies_menu.links.size > 0 -%}
    {%- assign policy_links = policies_menu.links -%}
  {%- else -%}
    {%- assign policy_links = shop.policies -%}
  {%- endif -%}
  {%- if policy_links.size > 0 -%}
    <div class="glomarrt-drawer__group">
      {%- if section.settings.drawer_policies_heading != blank -%}
        <p class="glomarrt-drawer__group-title">{{ section.settings.drawer_policies_heading }}</p>
      {%- endif -%}
      <ul class="glomarrt-drawer__links list-unstyled" role="list">
        {%- for link in policy_links -%}
          <li><a href="{{ link.url }}" class="glomarrt-drawer__link focus-inset">{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>
