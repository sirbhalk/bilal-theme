{% comment %}
  Glomarrt line icons.
  Usage: {% render 'glomarrt-icon', name: 'truck', px: 24 %}
  Names: cash, truck, shield, whatsapp, return, check, search, arrow
{% endcomment %}
{%- liquid
  assign icon_size = px | default: 24
-%}
<svg
  class="glomarrt-icon glomarrt-icon--{{ name }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'cash' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="2"></rect>
      <circle cx="12" cy="12" r="2.6"></circle>
      <path d="M6 9.5v5M18 9.5v5"></path>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11z"></path>
      <path d="M13.5 9.5h4l3 3v3h-7"></path>
      <circle cx="6.5" cy="17" r="1.8"></circle>
      <circle cx="17" cy="17" r="1.8"></circle>
    {%- when 'shield' -%}
      <path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z"></path>
      <path d="M8.8 12l2.3 2.3 4.2-4.6"></path>
    {%- when 'whatsapp' -%}
      <path d="M4 20l1.4-4A8 8 0 1 1 8 18.6L4 20z"></path>
      <path d="M9 9.5c.5 2 2.5 4 4.5 4.5l1-1.2 2 1-.5 1.5c-3.5.3-7.3-3.5-7-7l1.5-.5 1 2L9 9.5z"></path>
    {%- when 'return' -%}
      <path d="M4 10h11a5 5 0 0 1 0 10H9"></path>
      <path d="M8 6l-4 4 4 4"></path>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.5-3.5"></path>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    {%- else -%}
      <path d="M5 12l4 4 10-10"></path>
  {%- endcase -%}
</svg>
