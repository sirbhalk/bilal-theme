      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "كيفاش نطلب هاد المنتج؟",
            "answer": "<p>عمّر الفورم بالاسم ورقم الهاتف والمدينة، ومن بعد كنتاصلو بيك باش نأكدو الطلب. ولا طلب مباشرة عبر واتساب.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "شحال كياخد التوصيل؟",
            "answer": "<p>كنجهزو الطلب في ظرف 12 إلى 24 ساعة، والتوصيل كياخد غالباً ما بين 24 و72 ساعة حسب المدينة.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "واش نخلّص قبل ما توصلني السلعة؟",
            "answer": "<p>لا، الدفع عند الاستلام. كتخلّص غير ملي توصلك الطلبية.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "واش يمكن نرجع ولا نبدل المنتج؟",
            "answer": "<p>نعم، خلال 7 أيام من الاستلام، بشرط يكون المنتج في حالته الأصلية، ما يكونش مستعمل، ومع التغليف الأصلي.</p>"
          }
        }
      },
