{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "releasit_cod": {
          "type": "shopify://apps/releasit-cod-form/blocks/button-app-block/72faf214-4174-4fec-886b-0d0e8d3af9a2",
          "settings": {
            "product": "{{product}}"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "trust": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "price_tag",
            "heading_1": "الدفع عند الاستلام",
            "icon_2": "truck",
            "heading_2": "توصيل لجميع المدن",
            "icon_3": "return",
            "heading_3": "إرجاع خلال 7 أيام"
          }
        },
        "description": {
          "type": "description"
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "الشحن والإرجاع",
            "icon": "truck",
            "content": "<p>نقوم بمعالجة جميع الطلبات خلال <strong>24 إلى 48 ساعة</strong>. بعد شحن الطلب، ستتوصل برقم تتبع لتتبع شحنتك بسهولة.</p><p>يمكن إرجاع أو تبديل المنتج خلال 7 أيام من الاستلام، بشرط يكون في حالته الأصلية ومع التغليف الأصلي.</p>"
          }
        },
        "guarantee": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "ضماننا لك",
            "icon": "check_mark",
            "content": "<p>نحن نلتزم بتقديم تجربة تسوق آمنة ومرضية لك من البداية إلى النهاية. جميع منتجاتنا مختارة بعناية لضمان أعلى جودة، وفريقنا متاح دائمًا لمساعدتك والرد على استفساراتك.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "شارك"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "releasit_cod",
        "buy_buttons",
        "trust",
        "description",
        "shipping",
        "guarantee",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 20,
        "padding_bottom": 24
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "قد يعجبك أيضاً",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}