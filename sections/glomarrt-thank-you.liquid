{%- comment -%}
  Glomarrt: thank you page shown after a cash-on-delivery order
  (point the COD form app's "redirect after order" to this page).
  This is a normal page, so it has no access to the order itself.
{%- endcomment -%}
{%- liquid
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="glomarrt-thanks color-{{ section.settings.color_scheme }} gradient">
    <span class="glomarrt-thanks__badge" aria-hidden="true">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
    </span>
    <h1 class="glomarrt-thanks__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="glomarrt-thanks__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="glomarrt-thanks__steps list-unstyled" role="list">
        {%- for block in section.blocks -%}
          <li class="glomarrt-thanks__step" {{ block.shopify_attributes }}>
            <span class="glomarrt-thanks__step-icon">{% render 'glomarrt-icon', name: block.settings.icon, px: 24 %}</span>
            <span class="glomarrt-thanks__step-text">
              <span class="glomarrt-thanks__step-title">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}
                <span class="glomarrt-thanks__step-desc">{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="glomarrt-thanks__note">{{ section.settings.note }}</p>
    {%- endif -%}

    <div class="glomarrt-thanks__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button glomarrt-button--inverse">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
      {%- if section.settings.show_whatsapp and wa_number != blank -%}
        <a
          class="button button--secondary glomarrt-thanks__wa"
          href="https://wa.me/{{ wa_number }}?text={{ section.settings.whatsapp_message | url_encode }}"
          target="_blank"
          rel="noopener"
        >
          {%- render 'glomarrt-icon', name: 'whatsapp', px: 20 -%}
          {{ section.settings.whatsapp_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Glomarrt: thank you",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Set your COD form app to redirect customers to this page after they order."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "شكراً، توصلنا بالطلب ديالك!"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>الطلب ديالك تسجل بنجاح. غادي نتاصلو بيك قريب باش نأكدو معاك المعلومات.</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Important note",
      "default": "عافاك خلّي التيليفون ديالك مشعول، باش ما يتعطلش الطلب ديالك."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "كمّل التسوق"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp button",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "تواصل معنا على واتساب"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp message",
      "default": "السلام عليكم، دابا درت طلب فالموقع وبغيت نأكدو"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Next step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "whatsapp", "label": "Phone / WhatsApp" },
            { "value": "truck", "label": "Delivery" },
            { "value": "cash", "label": "Pay on delivery" },
            { "value": "check", "label": "Check" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glomarrt: thank you"
    }
  ]
}
{% endschema %}
