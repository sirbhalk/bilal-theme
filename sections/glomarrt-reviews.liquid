{%- comment -%}
  Glomarrt: customer reviews.
  Only real reviews entered by the merchant are shown. The average and count are
  calculated from the reviews in this section; nothing is invented.
{%- endcomment -%}
{%- liquid
  assign review_count = section.blocks.size
  assign rating_sum = 0
  for block in section.blocks
    assign rating_sum = rating_sum | plus: block.settings.rating
  endfor
  if review_count > 0
    assign rating_avg = rating_sum | times: 1.0 | divided_by: review_count | round: 1
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if review_count > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="glomarrt-reviews__head">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="glomarrt-heading h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="glomarrt-reviews__sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.show_average -%}
          <div class="glomarrt-reviews__summary">
            <span class="glomarrt-reviews__avg">{{ rating_avg }}</span>
            <span class="glomarrt-stars" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_avg, rating_max: 5 }}">
              {%- render 'glomarrt-stars', rating: rating_avg -%}
            </span>
            <span class="glomarrt-reviews__count">{{ 'glomarrt.reviews_count' | t: count: review_count }}</span>
          </div>
        {%- endif -%}
      </div>

      <ul class="glomarrt-reviews__list list-unstyled" role="list">
        {%- for block in section.blocks -%}
          <li class="glomarrt-review" {{ block.shopify_attributes }}>
            <span class="glomarrt-stars" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}">
              {%- render 'glomarrt-stars', rating: block.settings.rating -%}
            </span>
            {%- if block.settings.title != blank -%}
              <p class="glomarrt-review__title">{{ block.settings.title }}</p>
            {%- endif -%}
            <div class="glomarrt-review__text rte">{{ block.settings.text }}</div>
            {%- if block.settings.image != blank -%}
              <div class="glomarrt-review__photo">
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '200, 400, 600', sizes: '(min-width: 990px) 25vw, 70vw', class: 'glomarrt-cover'
                }}
              </div>
            {%- endif -%}
            <div class="glomarrt-review__footer">
              <span class="glomarrt-review__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
              <span class="glomarrt-review__who">
                <span class="glomarrt-review__name">{{ block.settings.name }}</span>
                {%- if block.settings.city != blank -%}
                  <span class="glomarrt-review__city">{{ block.settings.city }}</span>
                {%- endif -%}
              </span>
              {%- if block.settings.product != blank -%}
                <a class="glomarrt-review__product" href="{{ block.settings.product.url }}">{{ block.settings.product.title }}</a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section-{{ section.id }}-padding">
    <div class="glomarrt-editor-hint">
      <strong>{{ section.settings.heading }}</strong>
      <p>Add a "Review" block for each real customer review (name, city, rating, text, optional photo). This section stays hidden on the store until it has at least one review.</p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Glomarrt: reviews",
  "tag": "section",
  "class": "section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "paragraph",
      "content": "Only add real reviews from real customers. The average rating is calculated from the reviews you add here."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "آراء زبنائنا"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "شنو قالو الناس اللي شراو من عندنا"
    },
    {
      "type": "checkbox",
      "id": "show_average",
      "label": "Show average rating",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Short title (optional)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo of the product (optional)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product reviewed (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glomarrt: reviews"
    }
  ]
}
{% endschema %}
