{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="page-width glomarrt-hero{% if section.blocks.size == 0 %} glomarrt-hero--solo{% endif %}">
    <div class="glomarrt-hero__main color-{{ section.settings.color_scheme }} gradient">
      <div class="glomarrt-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="glomarrt-pill">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="glomarrt-hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="glomarrt-hero__text">{{ section.settings.text }}</div>
        {%- endif -%}
        <div class="glomarrt-hero__buttons">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              {% if section.settings.button_link_1 != blank %}
                href="{{ section.settings.button_link_1 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button glomarrt-button--inverse"
            >
              {{- section.settings.button_label_1 -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button button--secondary glomarrt-button--ghost"
            >
              {{- section.settings.button_label_2 -}}
            </a>
          {%- endif -%}
        </div>
      </div>
      <div class="glomarrt-hero__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 990px) 33vw, 100vw',
              widths: '375, 550, 750, 1000, 1200',
              class: 'glomarrt-cover'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg glomarrt-cover' }}
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="glomarrt-hero__side">
        {%- for block in section.blocks -%}
          <a
            {% if block.settings.link != blank %}
              href="{{ block.settings.link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="glomarrt-promo color-{{ block.settings.color_scheme }} gradient{% if block.settings.image != blank %} glomarrt-promo--image{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  widths: '375, 550, 800',
                  class: 'glomarrt-promo__image'
              }}
            {%- endif -%}
            <span class="glomarrt-promo__content">
              {%- if block.settings.eyebrow != blank -%}
                <span class="glomarrt-promo__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}
              <span class="glomarrt-promo__title">{{ block.settings.title }}</span>
              {%- if block.settings.link_label != blank -%}
                <span class="glomarrt-promo__cta">
                  {{- block.settings.link_label }}
                  {% render 'glomarrt-icon', name: 'arrow', px: 16 -%}
                </span>
              {%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Glomarrt: hero",
  "tag": "section",
  "class": "section glomarrt-hero-section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "متجر واحد، كل ما تحتاجه"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "تسوّق الآن بأفضل العروض والمنتجات المميزة"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>إلكترونيات، مستلزمات الدار، التجميل والملابس. اطلب اليوم وخلّص ملي توصلك السلعة.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button label",
      "default": "تسوّق الآن"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "شوف العروض"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo card",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "scheme-5"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label",
          "default": "عرض لفترة محدودة"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "تخفيضات الدار والمطبخ"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "اكتشف"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glomarrt: hero",
      "blocks": [
        { "type": "promo" },
        { "type": "promo", "settings": { "eyebrow": "وصل جديد", "title": "إكسسوارات الهاتف" } }
      ]
    }
  ]
}
{% endschema %}
