<div class="glomarrt-topbar color-{{ section.settings.color_scheme }} gradient" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
  <div class="page-width glomarrt-topbar__inner">
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}
        <span class="glomarrt-topbar__dot" aria-hidden="true">•</span>
      {%- endunless -%}
      <span class="glomarrt-topbar__item{% unless forloop.first %} glomarrt-topbar__item--extra{% endunless %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="glomarrt-topbar__link">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </span>
    {%- endfor -%}
  </div>

  {%- if section.settings.mobile_marquee and section.blocks.size > 0 -%}
    <div class="glomarrt-topbar__marquee" style="--marquee-duration: {{ section.settings.marquee_speed }}s;" aria-hidden="true">
      <div class="glomarrt-topbar__track">
        {%- for copy in (1..4) -%}
          {%- for block in section.blocks -%}
            <span class="glomarrt-topbar__m-item" dir="auto">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="glomarrt-topbar__link" tabindex="-1">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
            <span class="glomarrt-topbar__dot">•</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Glomarrt: top bar",
  "class": "glomarrt-topbar-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "mobile_marquee",
      "label": "Scrolling text on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Scroll duration (lower is faster)",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "التوصيل لجميع مدن المغرب"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glomarrt: top bar",
      "blocks": [
        { "type": "item", "settings": { "text": "التوصيل لجميع مدن المغرب" } },
        { "type": "item", "settings": { "text": "الدفع عند الاستلام" } }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
