<div class="glomarrt-topbar color-{{ section.settings.color_scheme }} gradient" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
  <div class="page-width glomarrt-topbar__inner">
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}
        <span class="glomarrt-topbar__dot" aria-hidden="true">•</span>
      {%- endunless -%}
      <span class="glomarrt-topbar__item{% unless forloop.first %} glomarrt-topbar__item--extra{% endunless %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="glomarrt-topbar__link">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Glomarrt: top bar",
  "class": "glomarrt-topbar-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "التوصيل لجميع مدن المغرب"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glomarrt: top bar",
      "blocks": [
        { "type": "item", "settings": { "text": "التوصيل لجميع مدن المغرب" } },
        { "type": "item", "settings": { "text": "الدفع عند الاستلام" } }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
