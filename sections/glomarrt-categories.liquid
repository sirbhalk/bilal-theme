{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="glomarrt-heading-row">
      {%- if section.settings.heading != blank -%}
        <h2 class="glomarrt-heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="glomarrt-heading-row__link link">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <ul class="glomarrt-cats list-unstyled" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat = block.settings.collection
          assign cat_title = block.settings.title
          if cat_title == blank and cat != blank
            assign cat_title = cat.title
          endif
          if cat_title == blank
            assign cat_title = 'glomarrt.category' | t
          endif
          assign cat_image = block.settings.image
          if cat_image == blank and cat != blank
            assign cat_image = cat.featured_image
          endif
        -%}
        <li class="glomarrt-cats__item" {{ block.shopify_attributes }}>
          <a
            {% if cat != blank %}
              href="{{ cat.url }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="glomarrt-cats__link"
          >
            <span class="glomarrt-cats__circle">
              {%- if cat_image != blank -%}
                {{
                  cat_image
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 15vw, 33vw', widths: '165, 250, 330, 400', class: 'glomarrt-cover', alt: ''
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg glomarrt-cover' }}
              {%- endif -%}
            </span>
            <span class="glomarrt-cats__title">{{ cat_title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Glomarrt: categories",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "تسوّق حسب القسم"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "جميع الأقسام"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/collections"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the collection name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use the collection image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glomarrt: categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
